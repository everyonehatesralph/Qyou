# Supabase: shared orders in production. See SUPABASE_SETUP.md.
# Both values are public (they ship in the web app). Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Force a backend: supabase, or server (the local order server in server/).
# Default: supabase when both values above are set, otherwise server.
# VITE_ORDER_BACKEND=server

# Paying online with PayMongo (SUPABASE_SETUP.md, step 5). Server-side only: never prefix these
# with VITE_. On Vercel they go in the project's Environment Variables; for npm run dev or
# npm run server, set them in the shell (npm run dev uses a no-money stand-in when unset).
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsk_...
# PAYMONGO_METHODS=gcash,paymaya,qrph,card
# SUPABASE_SERVICE_ROLE_KEY=...   (Vercel only: lets the payment function record payments)
# PUBLIC_SITE_URL=https://cafe.example   (npm run server behind HTTPS: where the payment page sends guests back)

# Local order server (npm run dev / npm run server): the 6-digit staff PIN.
# npm run dev uses 123456 when unset; npm run server refuses staff sign-in without it.
QYOU_STAFF_PIN=123456

# Server Configuration (for local network hosting)
VITE_SERVER_PORT=3000
VITE_SERVER_HOST=192.168.1.100

# Debug Mode
VITE_DEBUG=false
